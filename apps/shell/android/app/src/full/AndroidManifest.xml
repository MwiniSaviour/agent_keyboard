<?xml version="1.0" encoding="utf-8"?>
<!--
  `full` (sideload) builds may ask for all-files access so the Models screen can find model files
  anywhere in shared storage (ADR-0012). Off until the user grants it in system settings; Play builds
  never declare it and scan only folders the user picks.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
</manifest>
